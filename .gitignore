# ============================================================
# СЕКРЕТЫ И ЛОКАЛЬНЫЕ КОНФИГИ
# ============================================================
# Переменные окружения (токены, ключи, пароли)
.env
.env.*
!.env.example

# Локальные PHP-конфиги (не попадают в репозиторий)
*.local.php
config.local.php

# ============================================================
# ЛОГИ
# ============================================================
# Все лог-файлы в любом месте
*.log

# Логи тестов: содержимое игнорируется,
# но папка с .gitkeep попадает в репозиторий
/tests/logs/*
!/tests/logs/.gitkeep

# Логи примеров (examples/runner.php)
/examples/logs/

# ============================================================
# СБОРКА ДОКУМЕНТАЦИИ (MkDocs)
# ============================================================
# Результат сборки mkdocs build — генерируется автоматически
/site/
docs/site/

# ============================================================
# PYTHON (для MkDocs, если установлен локально)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ============================================================
# PHP
# ============================================================
# Composer (если когда-нибудь появится)
/vendor/
composer.phar

# ============================================================
# IDE И РЕДАКТОРЫ
# ============================================================
# PhpStorm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code (кроме общих настроек для команды)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Vim / Sublime
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================================
# ОПЕРАЦИОННЫЕ СИСТЕМЫ
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ============================================================
# РАЗНОЕ
# ============================================================
# Временные файлы
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# Архивы (случайно закоммиченные)
*.zip
*.tar.gz
*.rar
*.7z